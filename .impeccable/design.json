 "narrative": {
  "northStar": "The Dark Screening Room",
  "keyCharacteristics": [
   "Black ground, footage and live water as the only large colour fields",
   "Didone display in uppercase for titles; a neutral grotesque in spaced capitals for credits",
   "One accent, reserved for live state",
   "Two motion speeds: 200ms for UI, 900ms for scenes",
   "Frames (anything holding moving image) share one radius; controls are pills"
  ],
  "rules": [
   {
    "name": "The Live Ember Rule",
    "section": "colors",
    "body": "The accent marks exactly one kind of thing: state that is live now."
   },
   {
    "name": "The Contrast Floor Rule",
    "section": "colors",
    "body": "Readable text never goes below #767676 (4.62:1)."
   },
   {
    "name": "The Credit Rule",
    "section": "typography",
    "body": "Small spaced capitals credit the work beside or below a title, never above it as a kicker."
   },
   {
    "name": "The Mono-Is-Data Rule",
    "section": "typography",
    "body": "Monospace is for numerals and measured values only."
   },
   {
    "name": "The 11px Floor Rule",
    "section": "typography",
    "body": "No text renders below 11px."
   },
   {
    "name": "The Glass-Over-Film Rule",
    "section": "elevation",
    "body": "Backdrop blur only separates a panel from moving image under it."
   }
  ]
 }
